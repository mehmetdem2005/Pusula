# ============================================
# KAVRA — Ortam Değişkenleri
# Bu dosyayı .env olarak kopyalayıp değerleri doldur
# ============================================

# --- Supabase ---
# Frankfurt (eu-central-1) region'ında project aç
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...   # SADECE backend, asla client'a

# --- Expo Mobile ---
EXPO_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_POSTHOG_KEY=

# --- Şifreleme ---
# 32-byte hex (64 karakter). Üretmek için:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MASTER_ENCRYPTION_KEY=

# --- Groq (admin, model sync için senin key'in) ---
GROQ_ADMIN_KEY=gsk_...

# --- OpenAI (embeddings için senin key'in) ---
OPENAI_API_KEY=sk-...

# --- Worker URL'leri ---
WORKER_LLM_URL=http://localhost:4001
WORKER_VOICE_URL=http://localhost:4002
WORKER_PDF_URL=http://localhost:4003

# --- Upstash Redis ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Resend ---
RESEND_API_KEY=

# --- Sentry ---
SENTRY_DSN=

# --- PostHog ---
POSTHOG_KEY=

# --- Stripe (Faz 7'de) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_YEARLY_PRICE_ID=
STRIPE_PRO_LIFETIME_PRICE_ID=

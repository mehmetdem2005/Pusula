# ============================================
# KAVRA — Ortam Değişkenleri
# Bu dosyayı .env olarak kopyalayıp değerleri doldur
# ============================================

# --- Supabase ---
# Frankfurt (eu-central-1) region'ında project aç
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...   # SADECE backend, asla client'a

# --- Expo Mobile ---
EXPO_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...
EXPO_PUBLIC_API_BASE_URL=http://localhost:4001
EXPO_PUBLIC_VOICE_BASE_URL=http://localhost:4002
EXPO_PUBLIC_PDF_BASE_URL=http://localhost:4003
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_POSTHOG_KEY=

# --- Şifreleme ---
# 32-byte hex (64 karakter). Üretmek için:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MASTER_ENCRYPTION_KEY=

# --- Groq (admin, model sync için senin key'in) ---
GROQ_ADMIN_KEY=gsk_...

# --- OpenAI (embeddings için senin key'in) ---
OPENAI_API_KEY=sk-...

# --- Worker URL'leri ---
WORKER_LLM_URL=http://localhost:4001
WORKER_VOICE_URL=http://localhost:4002
WORKER_PDF_URL=http://localhost:4003

# --- Piper (worker-voice için) ---
PIPER_BIN=/opt/piper/piper
PIPER_MODELS_PATH=/opt/piper/models

# --- Upstash Redis ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Resend ---
RESEND_API_KEY=

# --- Sentry ---
SENTRY_DSN=

# --- PostHog ---
POSTHOG_KEY=

# --- Stripe (Faz 7'de) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_YEARLY_PRICE_ID=
STRIPE_PRO_LIFETIME_PRICE_ID=

# ===== FAZ 7: Premium =====

# Stripe (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_MONTHLY=price_...
STRIPE_PRICE_YEARLY=price_...
STRIPE_PRICE_LIFETIME=price_...

# Modal F5-TTS (deploy sonrası alınır — infra/modal/README.md)
MODAL_F5TTS_URL=https://<workspace>--kavra-f5tts-synthesize.modal.run
MODAL_API_TOKEN=

# Cron worker — sistem-genel Groq key (weekly report üretiminde kullanılır)
SYSTEM_GROQ_KEY=gsk_...

# ===== FAZ 8: Multi-Auth + Admin + AI Features =====

# Email OTP (Resend - https://resend.com)
RESEND_API_KEY=re_...

# SMS OTP (Twilio)
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_FROM_NUMBER=+1...

# AI Image Generation (Replicate - https://replicate.com)
REPLICATE_API_TOKEN=r8_...

# Premium TTS (ElevenLabs)
ELEVENLABS_API_KEY=sk_...

# OAuth - Supabase Dashboard'dan ayarlanır:
# Google: cloud.google.com/apis/credentials → Authorized redirect: https://<project>.supabase.co/auth/v1/callback
# Apple: developer.apple.com/account/resources/identifiers/serviceId
# Facebook: developers.facebook.com (Instagram için aynı app)

# Twilio Verify (alternative phone OTP)
# TWILIO_VERIFY_SERVICE_SID=VA...

# ===== FAZ 9: Books + Dictionary + AI Translation =====

# Gemini (Türkçe sözlük + cümle çevirisi - en uygun fiyat/kalite)
GEMINI_API_KEY=AIza...

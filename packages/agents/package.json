{
  "name": "@pusula/agents",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./contracts": "./src/contracts/index.ts",
    "./orchestrator": "./src/orchestrator/index.ts",
    "./specialists": "./src/specialists/index.ts",
    "./background": "./src/background/index.ts",
    "./tools": "./src/tools/index.ts",
    "./runtime": "./src/runtime/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --emitDeclarationOnly false || tsc -p tsconfig.json",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:contracts": "vitest run tests/contracts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@pusula/llm-gateway": "workspace:*",
    "@pusula/scoring": "workspace:*",
    "@pusula/shared": "workspace:*",
    "@opentelemetry/api": "^1.9.0",
    "bullmq": "^5.34.5",
    "ioredis": "^5.4.2",
    "xstate": "^5.18.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}

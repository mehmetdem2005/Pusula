{
  "name": "@pusula/agents",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts/index.d.ts",
      "default": "./dist/contracts/index.js"
    },
    "./orchestrator": {
      "types": "./dist/orchestrator/index.d.ts",
      "default": "./dist/orchestrator/index.js"
    },
    "./specialists": {
      "types": "./dist/specialists/index.d.ts",
      "default": "./dist/specialists/index.js"
    },
    "./background": {
      "types": "./dist/background/index.d.ts",
      "default": "./dist/background/index.js"
    },
    "./tools": {
      "types": "./dist/tools/index.d.ts",
      "default": "./dist/tools/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "default": "./dist/runtime/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:contracts": "vitest run tests/contracts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@pusula/llm-gateway": "workspace:*",
    "@pusula/scoring": "workspace:*",
    "@pusula/shared": "workspace:*",
    "@opentelemetry/api": "^1.9.0",
    "bullmq": "^5.34.5",
    "ioredis": "^5.4.2",
    "xstate": "^5.18.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}

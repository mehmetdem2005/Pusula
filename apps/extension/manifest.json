{
  "manifest_version": 3,
  "name": "Pusula — Karar verirken kaybolma",
  "short_name": "Pusula",
  "description": "Karar verirken kaybolma. Türkiye için AI destekli emlak & oto ilan analiz, kelepir skoru ve pazarlama metni üretimi. (Beta)",
  "version": "0.0.1",
  "author": "Pusula",

  "permissions": ["storage", "sidePanel", "scripting", "activeTab"],
  "optional_permissions": ["cookies", "tabs"],
  "host_permissions": [
    "https://www.sahibinden.com/*",
    "https://sahibinden.com/*",
    "https://api.pusula.tr/*",
    "https://app.pusula.tr/*"
  ],

  "background": {
    "service_worker": "src/background/service-worker.ts",
    "type": "module"
  },

  "action": {
    "default_title": "Pusula paneli aç",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },

  "side_panel": {
    "default_path": "src/sidepanel/index.html"
  },

  "options_page": "src/options/index.html",

  "content_scripts": [
    {
      "matches": [
        "https://www.sahibinden.com/ilan/*",
        "https://www.sahibinden.com/kategori/*"
      ],
      "js": ["src/content/sahibinden.ts"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],

  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },

  "web_accessible_resources": [
    {
      "resources": ["src/sidepanel/index.html"],
      "matches": [
        "https://www.sahibinden.com/*",
        "https://sahibinden.com/*"
      ]
    }
  ],

  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https://api.pusula.tr https://app.pusula.tr"
  }
}

{
  "cli": {
    "version": ">= 14.0.0",
    "appVersionSource": "remote",
    "promptToConfigurePushNotifications": false
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": {
        "APP_ENV": "development",
        "EXPO_PUBLIC_API_BASE_URL": "http://localhost:4001",
        "EXPO_PUBLIC_VOICE_BASE_URL": "http://localhost:4002",
        "EXPO_PUBLIC_PDF_BASE_URL": "http://localhost:4003"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "ios": { "simulator": false },
      "env": {
        "APP_ENV": "staging",
        "EXPO_PUBLIC_API_BASE_URL": "https://api-staging.kavra.app",
        "EXPO_PUBLIC_VOICE_BASE_URL": "https://voice-staging.kavra.app",
        "EXPO_PUBLIC_PDF_BASE_URL": "https://pdf-staging.kavra.app"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": { "buildType": "app-bundle" },
      "ios": { "resourceClass": "m-medium" },
      "env": {
        "APP_ENV": "production",
        "EXPO_PUBLIC_API_BASE_URL": "https://api.kavra.app",
        "EXPO_PUBLIC_VOICE_BASE_URL": "https://voice.kavra.app",
        "EXPO_PUBLIC_PDF_BASE_URL": "https://pdf.kavra.app"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "founder@kavra.app",
        "ascAppId": "YOUR_ASC_APP_ID",
        "appleTeamId": "YOUR_APPLE_TEAM_ID"
      },
      "android": {
        "serviceAccountKeyPath": "./secrets/play-service-account.json",
        "track": "production",
        "releaseStatus": "draft"
      }
    },
    "preview": {
      "android": {
        "serviceAccountKeyPath": "./secrets/play-service-account.json",
        "track": "internal"
      }
    }
  }
}

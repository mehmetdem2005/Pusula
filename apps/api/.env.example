# ─── Server ──────────────────────────────────────────────
NODE_ENV=development
PORT=3001
LOG_LEVEL=info
APP_VERSION=0.0.1

# ─── Database ────────────────────────────────────────────
DATABASE_URL=postgresql://pusula:pusula_dev@localhost:5432/pusula_dev
REDIS_URL=redis://localhost:6379

# ─── Supabase ────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...
# Server-only — asla client'a sızdırma
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
# JWKS endpoint kullanılır; sadece HS256 fallback için gerek varsa:
SUPABASE_JWT_SECRET=

# ─── CORS / Security ─────────────────────────────────────
# Virgülle ayrılmış mutlak origin'ler. REGEX YOK.
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://app.pusula.tr,https://staging.pusula.tr
# Chrome extension public ID'leri (chrome-extension://<id>)
EXT_IDS=

# ─── Observability ───────────────────────────────────────
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=pusula-api
POSTHOG_KEY=

# ─── Rate limit ──────────────────────────────────────────
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=60
THROTTLE_LLM_LIMIT=20
